# Server Configuration
 NODE_ENV=development
 PORT=3000
 HOST=0.0.0.0

 # API Configuration
 API_VERSION=v1
 API_PREFIX=/api/v1

 # CORS Configuration
 CORS_ORIGIN=http://localhost:3001
 CORS_CREDENTIALS=true

 # Logging
 LOG_LEVEL=info

 # JWT
 JWT_SECRET=your-secret-key-here-change-in-production
 JWT_EXPIRATION=24h

 # Database
 DATABASE_URLfile:sqlite:./db.sqlite