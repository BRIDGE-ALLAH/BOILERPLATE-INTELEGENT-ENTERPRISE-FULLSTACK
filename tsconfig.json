{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@repo/types": ["packages/types/src"],
      "@repo/brand": ["packages/brand/src"],
      "@repo/brand/*": ["packages/brand/src/*"],
      "@repo/utils": ["packages/utils/src"],
      "@repo/config": ["packages/config/src"],
      "@repo/theme": ["packages/theme/src"],
      "@repo/constants": ["packages/constants/src"],
      "@repo/validation": ["packages/validation/src"],
      "@repo/auth": ["packages/auth/src"],
      "@repo/api-client": ["packages/api-client/src"],
      "@repo/ui-system": ["packages/ui-system/src"],
      "@repo/api-lib": ["packages/api-lib/src"],
      "@repo/navigation": ["packages/navigation/src"],
      "@repo/dev-fixtures": ["packages/dev-fixtures/src"],
      "@repo/fake-db": ["packages/fake-db"],
      "@repo/fake-db/*": ["packages/fake-db/*"],
      "@/*": ["apps/web/src/*"],
      "@core/*": ["apps/web/src/@core/*"],
      "@ubme/core": ["packages/ubme-core/src"],
      "@ubme/mikroorm": ["packages/ubme-mikroorm/src"],
      "@ubme/core": ["packages/ubme-core"],
      "@ubme/mikroorm": ["packages/ubme-mikroorm"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "apps/**/*.ts", "apps/**/*.tsx"],
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
