 {
   "compilerOptions": {
     "strict": true,
     "esModuleInterop": true,
     "skipLibCheck": true,
     "forceConsistentCasingInFileNames": true,
     "resolveJsonModule": true,
     "declaration": true,
     "declarationMap": true,
     "sourceMap": true,
     "lib": ["ES2020", "DOM", "DOM.Iterable"],
     "target": "ES2020",
     "module": "ESNext",
     "moduleResolution": "bundler",
     "allowImportingTsExtensions": true,
     "isolatedModules": true,
     "incremental": true,
     "plugins": [
       {
         "name": "next"
       }
     ]
   }
 }
