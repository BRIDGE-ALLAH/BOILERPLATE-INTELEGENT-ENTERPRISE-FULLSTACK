# Bun / Turborepo configuration

# Bun package manager
use-node-version=20.11.0
factory-mode=true

# Turbo
engine-strict=true
memory-cache-max-size=400
memory-cache-max-age=5m

# Packages
package-manager=bdw
registry=https://registry.npmjs.org/

# Workspaces
prefer-workspace-packages=true
shared-workspace-lockfile=true

# Node
node-linker=hoisted
>
